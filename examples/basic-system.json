{
  "name": "Basic System",
  "description": "Basic 65C02 system with test program",
  "cpu": {
    "type": "65C02",
    "clockSpeed": 1000000
  },
  "memory": {
    "ramSize": "0x7F00",
    "ramStart": "0x0000",
    "romImages": [
      {
        "file": "test-program.bin",
        "loadAddress": "0xF000",
        "format": "binary"
      }
    ]
  },
  "peripherals": {
    "acia": {
      "baseAddress": "0x7F70",
      "registerSize": 4,
      "baudRate": 9600
    },
    "via": {
      "baseAddress": "0x7F20",
      "registerSize": 16,
      "enableTimers": true,
      "portAConnections": [
        { "pin": 0, "device": "led", "type": "output" }
      ]
    }
  },
  "debugging": {
    "enableTracing": false,
    "breakOnReset": false
  }
}
