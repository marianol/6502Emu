{
  "name": "Apple II-like System",
  "description": "Configuration similar to Apple II computer",
  "cpu": {
    "type": "6502",
    "clockSpeed": 1023000
  },
  "memory": {
    "ramSize": "0xBF00",
    "ramStart": "0x0000",
    "romImages": [
      {
        "file": "applesoft-basic.bin",
        "loadAddress": "0xD000",
        "format": "binary",
        "description": "Applesoft BASIC interpreter"
      },
      {
        "file": "monitor.bin",
        "loadAddress": "0xF000",
        "format": "binary",
        "description": "System monitor"
      }
    ]
  },
  "peripherals": {
    "acia": {
      "baseAddress": "0xBF70",
      "registerSize": 4,
      "baudRate": 9600,
      "description": "Serial interface card"
    },
    "via": {
      "baseAddress": "0xBF20",
      "registerSize": 16,
      "enableTimers": true,
      "portAConnections": [
        { "pin": 0, "device": "Keyboard", "type": "input" },
        { "pin": 1, "device": "Keyboard", "type": "input" },
        { "pin": 2, "device": "Keyboard", "type": "input" },
        { "pin": 3, "device": "Keyboard", "type": "input" }
      ],
      "portBConnections": [
        { "pin": 0, "device": "Speaker",  "type": "output" },
        { "pin": 1, "device": "Cassette", "type": "bidirectional" }
      ],
      "description": "Keyboard and audio interface"
    }
  },
  "debugging": {
    "enableTracing": false,
    "breakOnReset": false,
    "symbolFile": null
  }
}
