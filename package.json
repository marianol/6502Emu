{
  "name": "6502-homebrew-emulator",
  "version": "1.4.0",
  "description": "A 6502/65C02 emulator for homebrew computer development",
  "main": "dist/emulator.js",
  "scripts": {
    "build": "tsc && npm run build:native",
    "build:native": "node-gyp rebuild",
    "build:ts": "tsc",
    "test": "jest",
    "dev": "ts-node src/emulator.ts",
    "cli": "ts-node src/cli.ts",
    "start": "npm run build && node dist/cli.js",
    "postinstall": "node -e \"const fs=require('fs'),path=require('path');['darwin-arm64','darwin-x64'].forEach(p=>{const h=path.join(__dirname,'node_modules/node-pty/prebuilds',p,'spawn-helper');try{if(fs.existsSync(h))fs.chmodSync(h,0o755);}catch(e){}});\""
  },
  "bin": {
    "6502-emulator": "./dist/cli.js"
  },
  "keywords": [
    "6502",
    "65C02",
    "emulator",
    "homebrew",
    "computer"
  ],
  "author": "Mariano Luna",
  "license": "MIT",
  "dependencies": {
    "js-yaml": "^4.1.0",
    "node-addon-api": "^7.0.0",
    "node-pty": "^1.1.0"
  },
  "devDependencies": {
    "@types/jest": "^29.0.0",
    "@types/js-yaml": "^4.0.0",
    "@types/node": "^20.0.0",
    "jest": "^29.0.0",
    "node-gyp": "^10.0.0",
    "ts-jest": "^29.0.0",
    "ts-node": "^10.0.0",
    "typescript": "^5.0.0"
  }
}
